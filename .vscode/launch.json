{
  "version": "0.2.0",
  "configurations": [
    {
        "name": "Rasp Pi Launch LiminalRack Standalone",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/Rack",
        "args": ["-l", "-b"],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "preLaunchTask": "build-standalone",
        "externalConsole": false,
        "MIMode": "gdb"
    },
    {
        "name": "MacOS Launch LiminalRack Standalone",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/Rack",
        "args": ["-l", "-r"],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "preLaunchTask": "build-standalone",
        "externalConsole": false,
        "MIMode": "lldb"
    },
    {
        "name": "experimental Launch LiminalRack Standalone",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/Rack",
        "args": ["-l", "-b"],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "preLaunchTask": "build-standalone",
        "externalConsole": false,
        "MIMode": "gdb",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            },
            {
                "description": "Set Disassembly Flavor to Intel",
                "text": "-gdb-set disassembly-flavor intel",
                "ignoreFailures": true
            }
        ]
    },
    
  ]
}